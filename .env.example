# Copy this file to `.env` (which is gitignored) and fill in only what you use.

# OpenAI
# OPENAI_API_KEY=

# Gemini / Vertex API key
# GEMINI_API_KEY=
# GOOGLE_API_KEY=
# GEMINI_API_MODE=generative
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com
# GEMINI_API_VERSION=v1beta
# For Vertex:
# GEMINI_API_MODE=vertex
# GEMINI_BASE_URL=https://aiplatform.googleapis.com
# GEMINI_API_VERSION=v1

# Optional file-based secret loading:
# OPENAI_API_KEY_FILE=/absolute/path/to/openai.key
# GEMINI_API_KEY_FILE=/absolute/path/to/gemini.key
# GOOGLE_API_KEY_FILE=/absolute/path/to/google.key
